import kotlin.Boolean;

CREATE TABLE DbPOD (
    id INTEGER NOT NULL,
    date TEXT NOT NULL,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    url TEXT NOT NULL,
    mediaType TEXT NOT NULL,
    favorite INTEGER AS Boolean DEFAULT 0 NOT NULL,
    type TEXT NOT NULL,
    PRIMARY KEY (id, type)
);

removeAllPOD:
DELETE FROM DbPOD;

getAllPOD:
SELECT * FROM DbPOD;

getAllFavoritePOD:
SELECT * FROM DbPOD WHERE favorite = 1;

findPODById:
SELECT * FROM DbPOD WHERE id = ?;

findByIdAndType:
SELECT * FROM DbPOD WHERE id = ? AND type = ?;

getPODCount:
SELECT COUNT(id) FROM DbPOD;

insertPODOnDb:
INSERT INTO DbPOD(id, date, title, description, url, mediaType, favorite, type)
VALUES (?, ?,?,?,?,?,?,?);

replacePOD:
REPLACE INTO DbPOD(id, date, title, description, url, mediaType, favorite, type)
VALUES (?, ?,?,?,?,?,?,?);

updatePOD:
UPDATE DbPOD SET favorite = ? WHERE id = ?;

-- Rows saved by versions of the app that used the legacy api.nasa.gov endpoint: images on the
-- apod.nasa.gov host (now redirected to an HTML page) and placeholder entries with the NASA logo.
-- Keep the conditions in sync with data/LegacyContent.kt.
getPODsNeedingRepair:
SELECT * FROM DbPOD
WHERE (mediaType = 'image'
       AND (url LIKE 'https://apod.nasa.gov/apod/image/%' OR url LIKE 'http://apod.nasa.gov/apod/image/%'))
   OR url = 'https://science.nasa.gov/wp-content/themes/nasa-child/assets/images/nasa-logo@2x.png'
ORDER BY favorite DESC, date DESC;

-- Leaves the favorite mark untouched.
repairPOD:
UPDATE DbPOD SET title = ?, description = ?, url = ?, mediaType = ? WHERE id = ? AND type = ?;